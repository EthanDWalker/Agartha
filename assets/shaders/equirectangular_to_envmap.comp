#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D equirectMap;
layout(binding = 1, rgba16f) uniform writeonly imageCube environmentMap;

const float PI = 3.14159265359;

vec3 getDirection(uint face, vec2 uv) {
    uv = uv * 2.0 - 1.0;
    vec3 dir;
    switch (face) {
        case 0: dir = normalize(vec3( 1.0, -uv.y, -uv.x)); break; // +X
        case 1: dir = normalize(vec3(-1.0, -uv.y,  uv.x)); break; // -X
        case 2: dir = normalize(vec3( uv.x,  1.0,  uv.y)); break; // +Y
        case 3: dir = normalize(vec3( uv.x, -1.0, -uv.y)); break; // -Y
        case 4: dir = normalize(vec3( uv.x, -uv.y,  1.0)); break; // +Z
        case 5: dir = normalize(vec3(-uv.x, -uv.y, -1.0)); break; // -Z
        default: dir = vec3(0.0); break;
    }
    return dir;
}

vec2 dirToEquirectUV(vec3 dir) {
    float theta = atan(dir.z, dir.x);
    float phi = acos(clamp(dir.y, -1.0, 1.0));
    return vec2((theta + PI) / (2.0 * PI), phi / PI);
}

void main() {
    const uint resolution = 512;

    uvec2 id = gl_GlobalInvocationID.xy;
    uint face = gl_GlobalInvocationID.z;

    if (id.x >= resolution || id.y >= resolution || face >= 6) return;

    vec2 uv = (vec2(id) + 0.5) / float(resolution);
    vec3 dir = getDirection(face, uv);
    vec2 eqUV = dirToEquirectUV(dir);
    vec3 color = texture(equirectMap, eqUV).rgb;

    imageStore(environmentMap, ivec3(id, int(face)), vec4(color, 1.0));
}
