#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D equirectEnvMap;

layout(binding = 1, rgba16f) uniform imageCube irradianceMap;

// Constants
const float PI = 3.14159265359;

// Hemisphere sample count
const uint SAMPLE_COUNT = 1024;

// Direction calculation helpers
vec3 getCubeMapDirection(uint face, vec2 uv) {
    uv = uv * 2.0 - 1.0;

    if (face == 0) return normalize(vec3(1.0, -uv.y, -uv.x)); // +X
    if (face == 1) return normalize(vec3(-1.0, -uv.y, uv.x)); // -X
    if (face == 2) return normalize(vec3(uv.x, 1.0, uv.y)); // +Y
    if (face == 3) return normalize(vec3(uv.x, -1.0, -uv.y)); // -Y
    if (face == 4) return normalize(vec3(uv.x, -uv.y, 1.0)); // +Z
    return normalize(vec3(-uv.x, -uv.y, -1.0)); // -Z
}

// Equirectangular sampling (phi, theta)
vec3 sampleEquirectangular(vec3 dir) {
    float phi = atan(dir.z, dir.x);
    float theta = acos(clamp(dir.y, -1.0, 1.0));
    float u = (phi + PI) / (2.0 * PI);
    float v = theta / PI;
    return texture(equirectEnvMap, vec2(u, v)).rgb;
}

void main() {
    uvec3 size = uvec3(imageSize(irradianceMap), 1.0);
    uint face = gl_GlobalInvocationID.z;
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (pixel.x >= size.x || pixel.y >= size.y || face >= 6) {
        return; // Bounds check
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size.xy);
    vec3 normal = getCubeMapDirection(face, uv);

    vec3 up = vec3(0.0, 1.0, 0.0);
    vec3 right = normalize(cross(up, normal));
    up = normalize(cross(normal, right));

    vec3 irradiance = vec3(0.0);

    for (uint i = 0; i < SAMPLE_COUNT; ++i) {
        float xi1 = float(i) / float(SAMPLE_COUNT);
        float xi2 = fract(sin(float(i) * 12.9898) * 43758.5453); // pseudo-random

        float phi = 2.0 * PI * xi1;
        float cosTheta = sqrt(1.0 - xi2);
        float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

        vec3 hemiDir = vec3(
                cos(phi) * sinTheta,
                sin(phi) * sinTheta,
                cosTheta
            );

        vec3 sampleDir = normalize(right * hemiDir.x + up * hemiDir.y + normal * hemiDir.z);
        irradiance += sampleEquirectangular(sampleDir) * cosTheta;
    }

    irradiance = PI * irradiance * (1.0 / float(SAMPLE_COUNT));

    imageStore(irradianceMap, ivec3(pixel, face), vec4(irradiance, 1.0));
}
