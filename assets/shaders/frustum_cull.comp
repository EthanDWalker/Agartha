#version 450
layout(local_size_x = 64) in;

#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(set = 0, binding = 0) buffer DrawCommands {
    DrawIndexedIndirectCommand drawCommands[];
};

layout(set = 0, binding = 1) buffer DrawCount {
    uint drawCount;
};

layout(set = 0, binding = 2) buffer VisibleInstances {
    uint visibleInstances[];
};

layout(set = 1, binding = 0) uniform CameraUBO {
    Camera camera;
};

layout(set = 2, binding = 0) readonly buffer Instances {
    Instance instances[];
};

layout(set = 3, binding = 1) readonly buffer GpuMeshes {
    GpuMesh gpuMeshes[];
};

layout(set = 3, binding = 2) readonly buffer SphereBoundsBuffer {
    SphereBounds sphereBounds[];
};

bool isBoundingSphereVisible(vec3 center, float radius);

void main() {
    uint id = gl_GlobalInvocationID.x;

    if (id == 0) {
        drawCount = 0;
    }

    barrier();

    Instance instance = instances[id];

    if (instance.matrix == mat4(0.0)) return;

    uint objectId = instance.objectIndex;
    SphereBounds bounds = sphereBounds[objectId];

    if (isBoundingSphereVisible(vec3(instance.matrix * vec4(0.0)), bounds.radius)) {
        uint index = atomicAdd(drawCount, 1);

        visibleInstances[index] = id;

        DrawIndexedIndirectCommand command;
        command.indexCount = gpuMeshes[objectId].indexCount;
        command.instanceCount = 1;
        command.firstIndex = gpuMeshes[objectId].firstIndex;
        command.vertexOffset = 0;
        command.firstInstance = index;

        drawCommands[index] = command;
    }
}

bool isBoundingSphereVisible(vec3 center, float radius) {
    Frustum frustum = camera.frustum;

    return !(
    dot(vec3(frustum.left), center) + frustum.left.w < -radius ||
        dot(vec3(frustum.right), center) + frustum.right.w < -radius ||
        dot(vec3(frustum.top), center) + frustum.top.w < -radius ||
        dot(vec3(frustum.bottom), center) + frustum.bottom.w < -radius ||
        dot(vec3(frustum.near), center) + frustum.near.w < -radius ||
        dot(vec3(frustum.far), center) + frustum.far.w < -radius
    );
}
